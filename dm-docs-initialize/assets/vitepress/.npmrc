# Supply-chain hardening for the docs toolchain.

# Never run package lifecycle scripts (postinstall etc.), the primary npm
# malware delivery vector.
ignore-scripts=true

# New dependencies are saved with exact versions, not ^ranges.
save-exact=true

# Cooldown: never resolve package versions published less than 7 days ago.
# Compromised versions are typically yanked within days of publication.
# Requires npm >= 11.10 (older npm warns "unknown config" and ignores it).
min-release-age=7
